# Generated by hoist for ${DOMAIN}. Managed file — re-rendered on deploy.
# certbot --nginx will add the listen 443 / ssl_* directives in place.
server {
    listen 80;
    listen [::]:80;
    server_name ${SERVER_NAMES};

    # Allow Let's Encrypt HTTP-01 challenges before TLS is set up.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    client_max_body_size 50m;

    location / {
        proxy_pass http://${UPSTREAM};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        # WebSocket / HTTP keep-alive support.
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_read_timeout  300s;
        proxy_send_timeout  300s;
    }
}
